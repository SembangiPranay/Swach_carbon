# Groq API Key (get from groq.com)
GROQ_API_KEY=gsk_your_key_here

# Tavily API Key (get from tavily.com)
TAVILY_API_KEY=your_tavily_key_here

# Google Gemini API Key (get from aistudio.google.com) - Fallback LLM
GEMINI_API_KEY=your_gemini_key_here

# Optional: Anthropic Claude (alternative fallback)
ANTHROPIC_API_KEY=sk_your_key_here

# Environment
ENVIRONMENT=development
DEBUG=true
